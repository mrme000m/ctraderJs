{
    "compilerOptions": {
        "baseUrl": ".",
        "declaration": true,
        "incremental": true,
        "inlineSources": true,
        "module": "CommonJS",
        "moduleResolution": "Node",
        "noImplicitReturns": true,
        "noImplicitOverride": true,
        "outDir": "build",
        "paths": {
            "@mrme000m/ctraderjs": ["./index.ts"],
            "@mrme000m/ctraderjs/*": ["./*"],
            "!/*": [ "./*" ],
            "#*": [ "./src/core/*" ]
        },
        "removeComments": true,
        "sourceMap": true,
        "strict": true,
        "target": "es6",
        "types": ["node"],
        "skipLibCheck": true
    },
    "include": [
        ".eslintrc.js",
        "jest.config.js",
        "**/*.ts"
    ],
    "plugins": [
        { "transform": "typescript-transform-paths" }
    ],
    "exclude": [ "build", "node_modules" ]
}
